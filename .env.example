# Variables d'environnement - FormIA

# MongoDB (legacy - non utilisé par FormIA)
MONGO_URL=mongodb://localhost:27017
DB_NAME=your_database_name

# Base URL de l'application
NEXT_PUBLIC_BASE_URL=https://votre-app.preview.emergentagent.com

# CORS
CORS_ORIGINS=*

# Supabase Configuration pour FormIA
# Obtenez ces valeurs sur https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_anon_key_ici

# Note: Ne committez JAMAIS le fichier .env avec de vraies credentials !
